# Supabase Configuration
# Copy this file to .env and fill in your values
# Get these from https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration (LIVE MODE)
# Get these from https://dashboard.stripe.com/apikeys
# IMPORTANT: These are LIVE keys — products already exist in your account
# DO NOT create new Stripe products

# Secret keys (NEVER commit these to git — add to Supabase Edge Function secrets)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key (safe to include in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
